{
  "redirects": [
    {
      "source": "/stats.json",
      "destination": "https://stats.odio.love/repos.json",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Link", "value": "</sitemap-index.xml>; rel=\"sitemap\"" }
      ]
    }
  ]
}
