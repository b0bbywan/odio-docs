---
import Default from '@astrojs/starlight/components/Head.astro';

const { entry } = Astro.locals.starlightRoute;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const howto = (entry?.data as { howto?: boolean } | undefined)?.howto === true;

const author = {
	'@type': 'Person',
	name: 'b0bbywan',
	url: 'https://github.com/b0bbywan',
};

const orgRef = { '@id': 'https://odio.love/#organization' };
const osRef = { '@id': 'https://odio.love/#os' };

const siteJsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Organization',
			'@id': 'https://odio.love/#organization',
			name: 'odio',
			url: 'https://odio.love',
			logo: {
				'@type': 'ImageObject',
				url: 'https://odio.love/logo.png',
			},
			description: 'Open-source Raspberry Pi audio streaming project: self-hosted, Home Assistant native, no telemetry.',
			founder: author,
			contactPoint: {
				'@type': 'ContactPoint',
				contactType: 'customer support',
				email: 'contact@odio.love',
				url: 'https://github.com/b0bbywan/odios/issues',
				availableLanguage: ['English', 'French'],
			},
			sameAs: [
				'https://github.com/b0bbywan',
				'https://docs.odio.love',
				'https://www.linkedin.com/in/mrequillart/',
				'https://mathieu-requillart.medium.com/',
			],
		},
		{
			'@type': 'WebSite',
			'@id': 'https://docs.odio.love/#website',
			name: 'odio docs',
			url: 'https://docs.odio.love',
			description: 'Documentation for odio, the open-source Raspberry Pi audio streamer.',
			inLanguage: 'en',
			publisher: orgRef,
		},
		{
			'@type': 'OperatingSystem',
			'@id': 'https://odio.love/#os',
			name: 'odio',
			url: 'https://odio.love',
			applicationCategory: 'MultimediaApplication',
			applicationSubCategory: 'Audio Streaming',
			operatingSystem: 'Raspberry Pi OS Lite (Trixie), Debian 13',
			processorRequirements: 'ARMv6, ARMv7, ARM64 (aarch64), x86-64',
			softwareRequirements: 'Raspberry Pi OS Lite (Trixie) or Debian 13; bare-metal install via curl',
			sameAs: ['https://github.com/b0bbywan/odios'],
			downloadUrl: 'https://odio.love/install',
			installUrl: 'https://odio.love/install',
			softwareHelp: {
				'@type': 'CreativeWork',
				url: 'https://docs.odio.love',
			},
			releaseNotes: 'https://github.com/b0bbywan/odios/releases',
			license: 'https://opensource.org/licenses/BSD-2-Clause',
			keywords: [
				'Raspberry Pi audio streamer',
				'self-hosted',
				'open-source',
				'Home Assistant',
				'AirPlay 2',
				'Bluetooth audio',
				'Snapcast multi-room',
				'UPnP DLNA',
				'Spotify Connect',
				'Tidal',
				'Qobuz',
				'MPD',
				'CD auto-play',
				'USB auto-play',
				'GnuDB',
				'MusicBrainz',
				'cover art',
				'no telemetry',
				'Volumio alternative',
			],
			author,
			publisher: orgRef,
			offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
		},
	],
};

const howToJsonLd = howto
	? {
			'@context': 'https://schema.org',
			'@type': 'HowTo',
			name: entry?.data?.title ?? 'odio guide',
			description: entry?.data?.description ?? '',
			url: canonical,
			mainEntityOfPage: canonical,
			inLanguage: 'en',
			about: osRef,
			author,
			publisher: orgRef,
		}
	: null;
---

<Default {...Astro.props}><slot /></Default>

<link rel="alternate" hreflang="en" href={canonical} />
<link rel="alternate" hreflang="x-default" href={canonical} />

<script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />

{howToJsonLd && (
	<script type="application/ld+json" set:html={JSON.stringify(howToJsonLd)} />
)}
