---
import Default from '@astrojs/starlight/components/Head.astro';
import { buildSiteGraph, buildHowToSchema } from '../data/seo';

const { entry } = Astro.locals.starlightRoute;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const howto = (entry?.data as { howto?: boolean } | undefined)?.howto === true;

const siteJsonLd = buildSiteGraph();
const howToJsonLd = howto ? buildHowToSchema(entry, canonical) : null;
---

<Default {...Astro.props}><slot /></Default>

<link rel="alternate" hreflang="en" href={canonical} />
<link rel="alternate" hreflang="x-default" href={canonical} />

<script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />

{howToJsonLd && (
	<script type="application/ld+json" set:html={JSON.stringify(howToJsonLd)} />
)}
