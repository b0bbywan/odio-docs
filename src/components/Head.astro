---
import Default from '@astrojs/starlight/components/Head.astro';
import {
	buildSiteGraph,
	buildHowToSchema,
	DEFAULT_TITLE,
	DEFAULT_DESCRIPTION,
	OG_IMAGE,
	OG_IMAGE_ALT,
	OG_IMAGE_WIDTH,
	OG_IMAGE_HEIGHT,
} from '../data/seo';

const { entry } = Astro.locals.starlightRoute;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const howto = (entry?.data as { howto?: boolean } | undefined)?.howto === true;

const pageTitle = entry?.data?.title ?? DEFAULT_TITLE;
const pageDescription = entry?.data?.description ?? DEFAULT_DESCRIPTION;

const siteJsonLd = buildSiteGraph();
const howToJsonLd = howto ? buildHowToSchema(entry, canonical) : null;
---

<Default {...Astro.props}><slot /></Default>

<meta name="robots" content="index, follow" />

<link rel="alternate" hreflang="en" href={canonical} />
<link rel="alternate" hreflang="x-default" href={canonical} />

<meta property="og:image" content={OG_IMAGE} />
<meta property="og:image:width" content={OG_IMAGE_WIDTH.toString()} />
<meta property="og:image:height" content={OG_IMAGE_HEIGHT.toString()} />
<meta property="og:image:alt" content={OG_IMAGE_ALT} />

<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta name="twitter:image" content={OG_IMAGE} />
<meta name="twitter:image:alt" content={OG_IMAGE_ALT} />

<script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />

{howToJsonLd && (
	<script type="application/ld+json" set:html={JSON.stringify(howToJsonLd)} />
)}
